{
  "name": "ai-video-generator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "types:db": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "worker": "tsx worker/index.ts",
    "test:full": "PW_SERVER=prod PW_FULL_RUN_SCRIPT=1 playwright test",
    "test:guard": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/run-guard/guard.test.mjs",
    "test:smoke": "playwright test --grep @smoke",
    "test:dev": "playwright test",
    "test:failed": "PW_SERVER=prod playwright test --last-failed",
    "test:changed": "playwright test --only-changed",
    "test:report": "playwright merge-reports --reporter html blob-report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "music-metadata": "^11.16.1",
    "next": "16.3.1",
    "openai": "^7.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "ffmpeg-static": "^5.3.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
