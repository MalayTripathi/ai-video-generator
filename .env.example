# Every env var the code reads is listed here with its purpose and default (CLAUDE.md hard
# rule 19; tests/env-drift.spec.ts enforces it). A commented-out line is an optional
# override shown at its code default - leave it commented to use the default.

# ---- Supabase ------------------------------------------------------------------------

# Project URL (required).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public anon key used by the browser and server clients (required).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key for server-only writes such as the credit ledger (required).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Provider keys ---------------------------------------------------------------------

# Anthropic API key, read by the SDK (required for any Claude call).
ANTHROPIC_API_KEY=sk-ant-your-api-key
# OpenAI API key, read by the SDK (required for image generation).
OPENAI_API_KEY=sk-your-openai-api-key
# ElevenLabs API key (required for voiceover, alignment and music).
ELEVENLABS_API_KEY=sk_your-elevenlabs-api-key

# ---- Claude models and output caps (src/lib/config/models.ts) --------------------------
# Model defaults: claude-sonnet-5 in production for creative work, claude-haiku-5-5
# everywhere else. Caps are dev cost ceilings, sized never to truncate normal output.

# Shot generation model - both the outline and the chunk calls. Default: claude-sonnet-5 in production, else claude-haiku-5-5.
# CLAUDE_SHOTS_MODEL=claude-haiku-5-5
# Max output tokens for the shot outline call. Default: 8000.
# CLAUDE_SHOT_OUTLINE_MAX_TOKENS=8000
# Max output tokens for one shot chunk call. Default: 8000.
# CLAUDE_SHOTS_MAX_TOKENS=8000
# Camera re-derivation model - Haiku in every environment. Default: claude-haiku-5-5.
# CLAUDE_CAMERA_MODEL=claude-haiku-5-5
# Max output tokens for camera re-derivation. Default: 500.
# CLAUDE_CAMERA_MAX_TOKENS=500
# Workbench agent model. Default: claude-sonnet-5 in production, else claude-haiku-5-5.
# CLAUDE_AGENT_MODEL=claude-haiku-5-5
# Max output tokens per agent call, thinking included. Default: 8192.
# CLAUDE_AGENT_MAX_TOKENS=8192
# Image prompt writing model. Default: claude-sonnet-5 in production, else claude-haiku-5-5.
# CLAUDE_IMAGE_PROMPTS_MODEL=claude-haiku-5-5
# Max output tokens for one image-prompts call. Default: 8192.
# CLAUDE_IMAGE_PROMPTS_MAX_TOKENS=8192
# Music style prompt model - Haiku in every environment. Default: claude-haiku-5-5.
# CLAUDE_MUSIC_PROMPT_MODEL=claude-haiku-5-5
# Max output tokens for the music style prompt. Default: 500.
# CLAUDE_MUSIC_PROMPT_MAX_TOKENS=500

# ---- Images ----------------------------------------------------------------------------
# The image model and provider come from the registry in models.ts and each project's
# quality setting - never env. Sizes, timeouts and WebP quality live in storyboard.ts.

# Caps the image quality actually sent (and charged) to low / medium / high outside production. Default: unset (no cap).
# IMAGE_QUALITY_DEV_CAP=low

# ---- Background runs -------------------------------------------------------------------

# Shared secret a background run (storyboard images, shot generation) presents when it calls its own route to continue. Any long random string; REQUIRED on Vercel in every environment. Default: unset (a run cannot continue past one invocation; the rest is released failed).
INTERNAL_CONTINUATION_SECRET=

# ---- Voiceover and music (Step 4) ------------------------------------------------------
# Voices live in models.ts (VOICEOVER_VOICES); limits and timeouts in storyboard.ts.

# Voiceover provider; only elevenlabs is implemented. Default: elevenlabs.
VOICEOVER_PROVIDER=elevenlabs
# Text-to-speech model; eleven_v3 is required for inline audio tags. Default: eleven_v3.
ELEVENLABS_VOICEOVER_MODEL=eleven_v3
# Background music provider; only elevenlabs is implemented. Default: elevenlabs.
# MUSIC_PROVIDER=elevenlabs
# Background music model (always instrumental). Default: music_v1.
# ELEVENLABS_MUSIC_MODEL=music_v1

# ---- Export (src/lib/config/export.ts) -------------------------------------------------

# x264 quality of the rendered film. Default: 20.
# EXPORT_CRF=20
# Output frame rate. Default: 30.
# EXPORT_FPS=30
# Factor each still is scaled up by before zoompan, so motion lands on sub-pixels. Default: 4.
# EXPORT_MOTION_UPSCALE=4
# How often an idle export worker looks for a queued export, in ms. Default: 4000.
# EXPORT_POLL_MS=4000
# A render still running this long after it started is marked failed, in ms. Default: 1200000.
# EXPORT_STUCK_TIMEOUT_MS=1200000
# Outside production: the most shots a local render accepts. Default: 2.
# EXPORT_DEV_MAX_SHOTS=2
# Outside production: the longest film a local render accepts, in seconds. Default: 15.
# EXPORT_DEV_MAX_SEC=15

# ---- Spend controls --------------------------------------------------------------------

# Monthly spend ceiling check (src/lib/usage/allowance.ts): 1 enforces it, 0 disables it and runs no query. Default: 0.
SPEND_CAP_ENABLED=0
# The monthly ceiling in USD when SPEND_CAP_ENABLED=1. Default: 100.
SPEND_CAP_MONTHLY_USD=100

# Provider kill switch (live-call-guard.ts), every environment: any value but empty or 0 refuses every real Anthropic, OpenAI and ElevenLabs call and overrides ALLOW_REAL_*. Playwright always sets it to 1. Default: 0.
BLOCK_PROVIDER_CALLS=0

# ---- Development only: live-call opt-ins ------------------------------------------------
# Set to 1 by hand in your own shell only - never in a committed file, script or CI.

# 1 allows live Claude calls outside production. Default: 0.
ALLOW_REAL_CLAUDE=0
# 1 allows live OpenAI image calls outside production. Default: 0.
ALLOW_REAL_OPENAI_IMAGES=0
# 1 allows live ElevenLabs calls outside production. Default: 0.
ALLOW_REAL_ELEVENLABS=0

# ---- Test runner (set per command, not in .env.local) -----------------------------------

# prod serves a production build for the run (test:full, test:failed); anything else uses the dev server. Default: unset.
# PW_SERVER=prod
# Playwright workers for ui specs. Default: 2.
# PW_UI_WORKERS=2
# Playwright workers for api specs. Default: 4.
# PW_API_WORKERS=4
# The Step build a full run (>150 tests) is authorised for (tests/run-guard). Default: unset (full runs refused).
# PW_FULL_RUN_MODULE=storyboard
# 1 allows one logged run past a module's full-run cap. Default: unset.
# PW_FULL_RUN_OVERRIDE=1
# 1 makes the run guard report its decision without running. Default: unset.
# PW_RUN_GUARD_DRY_RUN=1
# Set by the test:full script only, so that script always needs a module. Default: unset.
# PW_FULL_RUN_SCRIPT=1
