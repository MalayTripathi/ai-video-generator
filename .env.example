# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Providers
ANTHROPIC_API_KEY=sk-ant-your-api-key
OPENAI_API_KEY=sk-your-openai-api-key
FALAI_API_KEY=sk-your-falai-api-key
ELEVENLABS_API_KEY=sk_your-elevenlabs-api-key

# Claude API
CLAUDE_SHOTS_MODEL=claude-sonnet-5
CLAUDE_SHOTS_MAX_TOKENS=8192

CLAUDE_CAMERA_MODEL=claude-haiku-4-5-20251001
CLAUDE_CAMERA_MAX_TOKENS=128

CLAUDE_AGENT_MODEL=claude-sonnet-5
CLAUDE_AGENT_MAX_TOKENS=8192

CLAUDE_IMAGE_PROMPTS_MODEL=claude-sonnet-5
CLAUDE_IMAGE_PROMPTS_MAX_TOKENS=8192

# Images (element references and Storyboard frames). The model and its provider come from
# the registry in src/lib/config/models.ts and each project's quality setting - never env.
# Sizes, timeouts and WebP quality live in src/lib/config/storyboard.ts.
# REQUIRED on Vercel (every environment that serves the images route). Shared secret a
# background image run presents when it calls the images route again to continue a large
# batch. Any long random string. Missing, a batch cannot continue past one run: the
# unreached shots are released failed (retryable) and the run logs an error.
IMAGES_INTERNAL_SECRET=

# Voiceover (Step 4). Voices live in models.ts (VOICEOVER_VOICES); limits and timeouts in
# src/lib/config/storyboard.ts. eleven_v3 is required for inline audio tags.
VOICEOVER_PROVIDER=elevenlabs
ELEVENLABS_VOICEOVER_MODEL=eleven_v3

# Optional, ignored in production: caps the image quality actually sent (and charged) to
# low / medium / high, whatever a project asks for - keeps development spend down.
# IMAGE_QUALITY_DEV_CAP=low

# Monthly spend ceiling (src/lib/usage/allowance.ts) - off by default, no query at all
# when disabled.
# SPEND_CAP_ENABLED=0. Monthly allowance check disabled (default)
# SPEND_CAP_ENABLED=1. Monthly allowance check enforced, ceiling below
SPEND_CAP_ENABLED=0
SPEND_CAP_MONTHLY_USD=100

# Provider kill switch (src/lib/providers/live-call-guard.ts) - every environment,
# production included. Blocks every real Anthropic, OpenAI and ElevenLabs call and
# overrides the ALLOW_REAL_* flags below. Playwright always sets it to 1 for test runs.
# BLOCK_PROVIDER_CALLS=0. Live API calls behave normally (default)
# BLOCK_PROVIDER_CALLS=1. All live API calls refused, in any environment
BLOCK_PROVIDER_CALLS=0

# Development Only

# ALLOW_REAL_CLAUDE=0. Live API Calls Stopped On Local Machine
# ALLOW_REAL_CLAUDE=1. Live API Calls Allowed On Local Machine
ALLOW_REAL_CLAUDE=0

# ALLOW_REAL_OPENAI_IMAGES=0. Live API Calls Stopped On Local Machine
# ALLOW_REAL_OPENAI_IMAGES=1. Live API Calls Allowed On Local Machine
ALLOW_REAL_OPENAI_IMAGES=0

# ALLOW_REAL_ELEVENLABS=0. Live API Calls Stopped On Local Machine
# ALLOW_REAL_ELEVENLABS=1. Live API Calls Allowed On Local Machine
ALLOW_REAL_ELEVENLABS=0
