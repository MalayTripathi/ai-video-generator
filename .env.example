# Every env var the code reads is listed here with its class and purpose (CLAUDE.md hard
# rule 19). src/lib/config/env.ts declares each var's class and validates it before the app,
# a build or the export worker starts; tests/env-drift.spec.ts keeps this file in step.
#
#   A  required everywhere - boot fails, naming the var, when it is missing or malformed.
#   B  required on preview and production - boot fails there when missing. On local, unset
#      takes the dev value shown here, with one boot warning per var.
#   C  IMAGE_QUALITY_DEV_CAP - required on local and preview; boot fails if set on production.
#   D  optional tuning - unset takes the code default shown, silently; a set but malformed
#      value fails boot everywhere. Listed commented out.
#   E  developer-only live-call opt-ins - listed commented out.
#   F  test runner - listed commented out; never set in .env.local.

# ---- Environment ------------------------------------------------------------------------

# A. Which environment this is: local | preview | production. Never inferred from NODE_ENV
# or VERCEL_ENV; on Vercel it must equal VERCEL_ENV.
APP_ENV=local

# ---- Supabase ---------------------------------------------------------------------------

# A. Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# A. Public anon key used by the browser and server clients.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# A. Service-role key for server-only writes such as the credit ledger.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Provider keys ----------------------------------------------------------------------

# A. Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-your-api-key
# A. OpenAI API key (image generation).
OPENAI_API_KEY=sk-your-openai-api-key
# A. ElevenLabs API key (voiceover, alignment and music).
ELEVENLABS_API_KEY=sk_your-elevenlabs-api-key

# ---- Background runs --------------------------------------------------------------------

# A. Shared secret a background run (storyboard images, shot generation) presents when it calls its own route to continue. At least 32 characters; generate one with `openssl rand -hex 32`.
INTERNAL_CONTINUATION_SECRET=replace-with-at-least-32-random-characters

# ---- Spend controls ---------------------------------------------------------------------

# A. Monthly spend ceiling check (src/lib/usage/allowance.ts): 1 enforces it, 0 disables it and runs no query.
SPEND_CAP_ENABLED=0
# A. The monthly ceiling in USD, a positive number (enforced when SPEND_CAP_ENABLED=1).
SPEND_CAP_MONTHLY_USD=100

# ---- Claude models and output caps (src/lib/config/models.server.ts) --------------------
# Model ids must have a rate in src/lib/config/pricing.ts. Caps are integers, 100-64000.
# The values below are the local dev values; production values are set in the deploy env.

# B. Shot generation model - both the outline and the chunk calls.
CLAUDE_SHOTS_MODEL=claude-haiku-5-5
# B. Max output tokens for the shot outline call.
CLAUDE_SHOT_OUTLINE_MAX_TOKENS=8000
# B. Max output tokens for one shot chunk call.
CLAUDE_SHOTS_MAX_TOKENS=8000
# B. Camera re-derivation model - Haiku in every environment.
CLAUDE_CAMERA_MODEL=claude-haiku-5-5
# B. Max output tokens for camera re-derivation.
CLAUDE_CAMERA_MAX_TOKENS=500
# B. Workbench agent model.
CLAUDE_AGENT_MODEL=claude-haiku-5-5
# B. Max output tokens per agent call, thinking included.
CLAUDE_AGENT_MAX_TOKENS=8192
# B. Image prompt writing model.
CLAUDE_IMAGE_PROMPTS_MODEL=claude-haiku-5-5
# B. Max output tokens for one image-prompts call.
CLAUDE_IMAGE_PROMPTS_MAX_TOKENS=8192
# B. Music style prompt model - Haiku in every environment.
CLAUDE_MUSIC_PROMPT_MODEL=claude-haiku-5-5
# B. Max output tokens for the music style prompt.
CLAUDE_MUSIC_PROMPT_MAX_TOKENS=500

# ---- Voiceover and music (Step 4) -------------------------------------------------------
# Voices live in models.ts (VOICEOVER_VOICES); limits and timeouts in storyboard.ts.

# B. Voiceover provider; only elevenlabs is supported.
VOICEOVER_PROVIDER=elevenlabs
# B. Text-to-speech model; only eleven_v3 is supported (inline audio tags need it).
ELEVENLABS_VOICEOVER_MODEL=eleven_v3
# B. Background music provider; only elevenlabs is supported.
MUSIC_PROVIDER=elevenlabs
# B. Background music model (always instrumental); only music_v1 is supported.
ELEVENLABS_MUSIC_MODEL=music_v1

# ---- Images -----------------------------------------------------------------------------
# The image model and provider come from the registry in models.ts and each project's
# quality setting - never env. Sizes, timeouts and WebP quality live in storyboard.ts.

# C. Caps the image quality actually sent (and charged): low / medium / high. Required on local and preview; must not be set on production.
IMAGE_QUALITY_DEV_CAP=low

# ---- Export (src/lib/config/export.ts) --------------------------------------------------

# D. x264 quality of the rendered film, 0-51. Default: 20.
# EXPORT_CRF=20
# D. Output frame rate. Default: 30.
# EXPORT_FPS=30
# D. Factor each still is scaled up by before zoompan, so motion lands on sub-pixels. Default: 4.
# EXPORT_MOTION_UPSCALE=4
# D. How often an idle export worker looks for a queued export, in ms. Default: 4000.
# EXPORT_POLL_MS=4000
# D. A render still running this long after it started is marked failed, in ms. Default: 1200000.
# EXPORT_STUCK_TIMEOUT_MS=1200000
# D. On local: the most shots a render accepts. Default: 2.
# EXPORT_DEV_MAX_SHOTS=2
# D. On local: the longest film a render accepts, in seconds. Default: 15.
# EXPORT_DEV_MAX_SEC=15
# D. The export worker's ffmpeg binary. Default: the ffmpeg-static dev dependency (the Docker image sets /usr/bin/ffmpeg).
# FFMPEG_PATH=/usr/bin/ffmpeg

# ---- Provider kill switch ---------------------------------------------------------------

# D. 1 refuses every real Anthropic, OpenAI and ElevenLabs call in any environment and overrides ALLOW_REAL_* (live-call-guard.ts); 0 or 1 only. Playwright always sets 1. Default: 0.
# BLOCK_PROVIDER_CALLS=0

# ---- E. Development only: live-call opt-ins ---------------------------------------------
# Set to 1 by hand in your own shell only - never in a committed file, script or CI.

# E. 1 allows live Claude calls on local. Default: 0.
# ALLOW_REAL_CLAUDE=0
# E. 1 allows live OpenAI image calls on local. Default: 0.
# ALLOW_REAL_OPENAI_IMAGES=0
# E. 1 allows live ElevenLabs calls on local. Default: 0.
# ALLOW_REAL_ELEVENLABS=0

# ---- F. Test runner ---------------------------------------------------------------------
# Set by the npm scripts, by the run guard, or by Claude Code per command. Never set in
# .env.local, and never read from it: playwright.config.ts reads these before any env file
# is loaded.

# F. prod serves a production build for the run (test:full, test:failed); anything else uses the dev server. Default: unset.
# PW_SERVER=prod
# F. Playwright workers for ui specs. Default: 2.
# PW_UI_WORKERS=2
# F. Playwright workers for api specs. Default: 4.
# PW_API_WORKERS=4
# F. The Step build a full run (>150 tests) is authorised for (tests/run-guard). Default: unset (full runs refused).
# PW_FULL_RUN_MODULE=storyboard
# F. 1 allows one logged run past a module's full-run cap. Default: unset.
# PW_FULL_RUN_OVERRIDE=1
# F. 1 makes the run guard report its decision without running. Default: unset.
# PW_RUN_GUARD_DRY_RUN=1
# F. Set by the test:full script only, so that script always needs a module. Default: unset.
# PW_FULL_RUN_SCRIPT=1
# F. Internal: set by the run guard on its own --list child process; never set by hand.
# PW_RUN_GUARD_CHILD=1
