# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API
ANTHROPIC_API_KEY=sk-ant-your-api-key
CLAUDE_SHOTS_MODEL=claude-sonnet-5
CLAUDE_SHOTS_MAX_TOKENS=8192
CLAUDE_PROMPTS_MODEL=claude-sonnet-5
CLAUDE_PROMPTS_MAX_TOKENS=8192
# Blocked by default outside production. Set to 1 only for a deliberate,
# developer-run live call against the real Anthropic API - never commit
# this as 1, and never set it automatically on the developer's behalf.
ALLOW_REAL_CLAUDE=0

# fal.ai
FAL_VIDEO_MODEL=Kling 2.1